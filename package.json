{
  "name": "part-time-god",
  "version": "0.2.1",
  "description": "兼职上帝：对话的同时也兼职作为上帝，创造一个你自己的世界。DSH 插件（宿主半边 + 浏览器半边）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "game"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-runtime": "*"
  }
}
